#!/bin/sh /etc/rc.common
# shellcheck shell=ash disable=SC2034
# procd service for a remotely managed Cloudflare Tunnel. Settings: /etc/config/cloudflared

START=99
STOP=10
USE_PROCD=1

# RutOS installs opkg packages under /usr/local, OpenWrt under /.
PROG=/usr/bin/cloudflared
[ -x "$PROG" ] || PROG=/usr/local$PROG

start_service() {
	local enabled token protocol loglevel

	config_load cloudflared
	config_get_bool enabled main enabled 0
	config_get token main token
	config_get protocol main protocol auto
	config_get loglevel main loglevel info

	[ "$enabled" -eq 1 ] || return 0
	if [ -z "$token" ]; then
		logger -t cloudflared "enabled but no token set in /etc/config/cloudflared"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" tunnel --no-autoupdate \
		--protocol "$protocol" --loglevel "$loglevel" run
	# Token via env, not argv, so it does not show in ps.
	procd_set_param env TUNNEL_TOKEN="$token"
	# Retry forever every 5 s: covers DNS, WAN and NTP not being ready at boot.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger cloudflared
}
